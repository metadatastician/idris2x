{"$id":"https://github.com/metadatastician/idris2x/channel/v1.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Signed data-only manifest. No scripts, no commands. A fix is a JSON diff + channel_version+1.","properties":{"bundles":{"additionalProperties":{"additionalProperties":{"additionalProperties":false,"properties":{"chez":{"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$","type":"string"},"min_glibc":{"pattern":"^[0-9]+\\.[0-9]+$","type":["string","null"]},"min_macos":{"type":["string","null"]},"provenance":{"description":"URL of the SLSA/sigstore attestation bundle (for humans and CI; the launcher does not verify it)","format":"uri","type":"string"},"sha256":{"pattern":"^[a-f0-9]{64}$","type":"string"},"size":{"minimum":1,"type":"integer"},"urls":{"items":{"format":"uri","pattern":"^https://","type":"string"},"minItems":1,"type":"array"}},"required":["urls","sha256","size","chez"],"type":"object"},"propertyNames":{"pattern":"^[a-z0-9_]+-[a-z]+-[a-z]+(-[a-z]+)?$"},"type":"object"},"propertyNames":{"pattern":"^idris2@[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9]+)?$"},"type":"object"},"channel_version":{"description":"monotonic; launcher refuses to go backwards past the lock","minimum":1,"type":"integer"},"compat":{"additionalProperties":{"properties":{"chez":{"type":"string"},"notes":{"type":"string"},"platforms":{"items":{"type":"string"},"type":"array"}},"required":["chez","platforms"],"type":"object"},"type":"object"},"deprecated":{"items":{"type":"string"},"type":"array"},"expires":{"description":"freeze protection; re-signed on every publish","format":"date-time","type":"string"},"min_launcher":{"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$","type":"string"},"schema":{"const":1}},"required":["schema","channel_version","expires","bundles","compat","deprecated"],"title":"idris2x compat channel v1","type":"object"}
